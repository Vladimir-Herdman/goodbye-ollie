   <text:p text:style-name="P57"/>
   <text:p text:style-name="Poetry_20_Text">Don&apos;t keep that heart:</text:p>
   <text:p text:style-name="P62">It&apos;s yours to forget,</text:p>
   <text:p text:style-name="P62">but</text:p>
   <text:p text:style-name="P62">please answer me this</text:p>
   <text:p text:style-name="P62">before you go.</text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P62">Does it matter<text:span text:style-name="T35">—</text:span></text:p>
   <text:p text:style-name="P62">should it matter</text:p>
   <text:p text:style-name="P62">how many lips</text:p>
   <text:p text:style-name="P62">tasted mine</text:p>
   <text:p text:style-name="P62">before yours?</text:p>
   <text:p text:style-name="P62">Was I only special</text:p>
   <text:p text:style-name="P62">when that heart</text:p>
   <text:p text:style-name="P62">thought of me</text:p>
   <text:p text:style-name="P62">alone?</text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P62">I&apos;m sorry.</text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P62">The pause right before</text:p>
   <text:p text:style-name="P62">I answer back</text:p>
   <text:p text:style-name="P62">when you say</text:p>
   <text:p text:style-name="P62">I love you.</text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P62">Sorry.</text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P62">When I call,</text:p>
   <text:p text:style-name="P62">just</text:p>
   <text:p text:style-name="P62">don&apos;t answer,</text:p>
   <text:p text:style-name="P62">please,</text:p>
   <text:p text:style-name="P62"><text:soft-page-break/>don&apos;t answer.</text:p>
   <text:p text:style-name="P62">Leave me alone</text:p>
   <text:p text:style-name="P62">and we can both</text:p>
   <text:p text:style-name="P62">move</text:p>
   <text:p text:style-name="P62">on.</text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P62">It&apos;s my fault,</text:p>
