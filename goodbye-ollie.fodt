   <text:p text:style-name="P77">of two <text:span text:style-name="T45">free men</text:span></text:p>
   <text:p text:style-name="P77">fucking up a cloud</text:p>
   <text:p text:style-name="P77">in the<text:span text:style-name="T9">re</text:span> them hills.</text:p>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P77">The glances</text:p>
   <text:p text:style-name="P77">shot over a quiet town</text:p>
   <text:p text:style-name="P77"><text:s text:c="3"/><text:span text:style-name="T33">bell toll</text:span></text:p>
   <text:p text:style-name="P79">at high noon,</text:p>
   <text:p text:style-name="P79">where once was a peaceful people<text:span text:style-name="T46">—</text:span></text:p>
   <text:p text:style-name="P79">fanatics choking on their grit,</text:p>
   <text:p text:style-name="P79">screaming at every thrust</text:p>
   <text:p text:style-name="P79">of the gunman <text:span text:style-name="T33">hyauh</text:span>.</text:p>
   <text:p text:style-name="P79"/>
   <text:p text:style-name="P79">No sherif</text:p>
