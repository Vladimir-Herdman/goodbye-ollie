   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1327_3007704144"/>Clean Up The Mess<text:bookmark-end text:name="__RefHeading___Toc1327_3007704144"/></text:h>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">No matter how much you wipe,</text:p>
   <text:p text:style-name="Poetry_20_Text">these streaks down your face</text:p>
   <text:p text:style-name="Poetry_20_Text">will forever brand your heart</text:p>
   <text:p text:style-name="Poetry_20_Text">and these eyes.</text:p>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">You are filthy,</text:p>
   <text:p text:style-name="Poetry_20_Text">not because of the dirt</text:p>
   <text:p text:style-name="Poetry_20_Text">and trash</text:p>
   <text:p text:style-name="Poetry_20_Text">that make up this space,</text:p>
   <text:p text:style-name="Poetry_20_Text">but because of the way</text:p>
