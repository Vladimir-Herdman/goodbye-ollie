     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc4869_1189619379" office:name="That I Don’t Miss You" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">That I Don’t Miss You<text:tab/>65</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2545_4237564503" office:name="That I’m A Good Liar" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">That I’m A Good Liar<text:tab/>66</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2543_4237564503" office:name="That I’m Happy" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">That I’m Happy<text:tab/>67</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc4867_1189619379" office:name="That It’s My Fault I’m Me" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">That It’s My Fault I’m Me<text:tab/>68</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc19035_1983556278" office:name="That No One Is Ever Corrupted" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">That No One Is Ever Corrupted<text:tab/>69</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc4865_1189619379" office:name="If You Loved Me" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">If You Loved Me<text:tab/>70</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc6573_3499536570" office:name="Oliver From Memory" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Oliver From Memory<text:tab/>72</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc11935_1015851859" office:name="Your Spit Drying Off My Lip" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Your Spit Drying Off My Lip<text:tab/>73</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc6571_3499536570" office:name="Modern" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Modern<text:tab/>74</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1969_4086586558" office:name="Nothing Hurts" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Nothing Hurts<text:tab/>75</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc9123_1015851859" office:name="Nothing Proves Your Alive" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Nothing Proves Your Alive<text:tab/>78</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1025_1230340041" office:name="I’m Not Struggling" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">I’m Not Struggling<text:tab/>80</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc6575_3499536570" office:name="Unlike Anyone Else" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Unlike Anyone Else<text:tab/>82</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc780_3676532460" office:name="Be Normal" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Be Normal<text:tab/>84</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1998_818021894" office:name="So What If I’m Not Normal" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">So What If I’m Not Normal<text:tab/>85</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc9121_1015851859" office:name="Flower of a Warrior" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Flower of a Warrior<text:tab/>86</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc11931_1015851859" office:name="How Could I Forget" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">How Could I Forget<text:tab/>87</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc19033_1983556278" office:name="No Advice Worth Giving" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">No Advice Worth Giving<text:tab/>88</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc4875_1189619379" office:name="Give Up" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Give Up<text:tab/>89</text:span></text:a></text:p>
     <text:p text:style-name="P20"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc776_3676532460" office:name="Goodbye Ollie," text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Goodbye Ollie,<text:tab/>90</text:span></text:a></text:p>
     <text:p text:style-name="P19"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1996_818021894" office:name="Acknowledgments" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">Acknowledgments<text:tab/>92</text:span></text:a></text:p>
     <text:p text:style-name="P19"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1994_818021894" office:name="About the Author" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">About the Author<text:tab/>93</text:span></text:a></text:p>
     <text:p text:style-name="P19"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1992_818021894" office:name="About the Muse" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T7">About the Muse<text:tab/>94</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P17"><text:soft-page-break/></text:p>
   <text:h text:style-name="P21" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1293_3676532460"/>Preface<text:bookmark-end text:name="__RefHeading___Toc1293_3676532460"/></text:h>
   <text:p text:style-name="P22"/>
   <text:p text:style-name="P23"><text:span text:style-name="T8">The sum total of this book amounts to nothing but a joke. I refuse to stop telling this joke all on the grounds that I find it funny. I’ve lately been stopping myself, because I think it’s in bad taste now that Ollie’s escaped me</text:span><text:span text:style-name="T9">: </text:span><text:span text:style-name="T8">I’ve reached my bounds. A book I reread recently captures what I hope to present through this collection</text:span>:</text:p>
   <text:p text:style-name="P24"/>
   <text:p text:style-name="Quote">All of the true things I am about to tell you are shameless lies.</text:p>
   <text:p text:style-name="Quote"><text:span text:style-name="T10">—</text:span><text:span text:style-name="T11">Kurt Vonnegut, Jr., </text:span><text:span text:style-name="T8">Cat’s Cradle</text:span></text:p>
   <text:p text:style-name="P25"/>
   <text:p text:style-name="P26">Nothing in these pages are true. Everything I’ve written comes from my heart and what I believe to be somewhat funny, or a little interesting. That probably means there’s something true in here, but that’s not up to me to decide.</text:p>
   <text:p text:style-name="P27"/>
   <text:p text:style-name="P28">Otherwise, all writing was formed with a single thought in mind: “How do I make Ollie a little uncomfortable here, but still willing to laugh about it?” If I hit the mark, you’ll know. <text:span text:style-name="T12">If not, forgive me— Nothing was meant too serious to cause harm. </text:span><text:span text:style-name="T13">And yes, I use the em-dash: NO AI was used throughout </text:span><text:span text:style-name="T14">this collection</text:span><text:span text:style-name="T13">.</text:span></text:p>
   <text:p text:style-name="P29"/>
   <text:p text:style-name="P30"><text:span text:style-name="T8">As a final </text:span><text:span text:style-name="T15">note on why I did this</text:span><text:span text:style-name="T8">, </text:span><text:span text:style-name="T15">t</text:span><text:span text:style-name="T16">here’s </text:span><text:span text:style-name="T17">nothing</text:span><text:span text:style-name="T16"> wrong with wanting to be an individual. </text:span><text:span text:style-name="T8">The only thing wrong is to </text:span><text:span text:style-name="T15">not </text:span><text:span text:style-name="T8">try.</text:span></text:p>
   <text:p text:style-name="P31"/>
   <text:p text:style-name="P30"><text:span text:style-name="T8">So that’s what I hope to get across here: I’m trying. I tried. </text:span><text:span text:style-name="T15">If I failed, better than those that never pursued a thought to its end.</text:span></text:p>
   <text:p text:style-name="P31"/>
   <text:p text:style-name="P32">Thank you.</text:p>
   <text:p text:style-name="P33"/>
   <text:p text:style-name="P34"/>
   <text:p text:style-name="Text_20_body"/>
   <text:p text:style-name="Text_20_body"/>
   <text:p text:style-name="Text_20_body"/>
   <text:p text:style-name="P35">I aint ever felt better and</text:p>
   <text:p text:style-name="P35">I aint ever been dumbe<text:span text:style-name="T1">r.</text:span></text:p>
   <text:p text:style-name="P36"><text:span text:style-name="T18">—</text:span><text:span text:style-name="T19">Jesse Welles</text:span></text:p>
   <text:p text:style-name="P37"/>
   <text:p text:style-name="P38">To give anything less than your best</text:p>
   <text:p text:style-name="P38">is to sacrifice the gift.</text:p>
   <text:p text:style-name="P39">—<text:span text:style-name="T20">Steve Prefontaine</text:span></text:p>
   <text:p text:style-name="P36"/>
   <text:p text:style-name="P40"><text:span text:style-name="Emphasis">I can’t even guess myself what it must be</text:span></text:p>
   <text:p text:style-name="P40"><text:span text:style-name="Emphasis">to live the life of a human being.</text:span></text:p>
   <text:p text:style-name="P36"><text:span text:style-name="Emphasis"><text:span text:style-name="T21">—</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T22">Osamu Dazai, </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T23">No Longer Human</text:span></text:span></text:p>
   <text:p text:style-name="P36"><text:span text:style-name="Emphasis"><text:span text:style-name="T23"/></text:span></text:p>
   <text:p text:style-name="P41">See the cat?</text:p>
   <text:p text:style-name="P42"><text:span text:style-name="Emphasis"><text:span text:style-name="T24">See the cradle?</text:span></text:span></text:p>
   <text:p text:style-name="P42"><text:span text:style-name="Emphasis"><text:span text:style-name="T21">—Kurt Vonnegut, Jr., </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T24">Cat’s Cradle</text:span></text:span></text:p>
   <text:p text:style-name="P36"><text:span text:style-name="Emphasis"><text:span text:style-name="T22"/></text:span></text:p>
   <text:p text:style-name="P43"><text:span text:style-name="Emphasis"><text:span text:style-name="T25">I don’t want to be normal,</text:span></text:span></text:p>
   <text:p text:style-name="P43"><text:span text:style-name="Emphasis"><text:span text:style-name="T25">I want to be me</text:span></text:span><text:span text:style-name="Emphasis">.</text:span></text:p>
   <text:p text:style-name="P43"><text:span text:style-name="Emphasis"><text:span text:style-name="T22">—</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T26">My Brain</text:span></text:span></text:p>
   <text:p text:style-name="P44" loext:marker-style-name="T27"><text:span text:style-name="T27"/></text:p>
   <text:p text:style-name="Text_20_body"/>
   <text:h text:style-name="P45" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc155_3645116443"/>Hello Ollie,<text:bookmark-end text:name="__RefHeading___Toc155_3645116443"/></text:h>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="P46">Hello Ollie,</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">From the first moment I met you I—</text:p>
   <text:p text:style-name="P46">When we met that fated August, I really wanted to just—</text:p>
   <text:p text:style-name="P46">Ollie, the effect you’ve had on me, truly...</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">I just can’t start this letter to you. I feel I can’t speak my mind. I don’t have the words to express myself, and I keep <text:span text:style-name="T13">trying to rewrite </text:span><text:span text:style-name="T28">everything</text:span>. So, that’s what this book is for.</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">I plan on expressing some emotions— or thoughts— at least somewhere within this piece, ideas I couldn’t fully write out, ideas I had to keep rewriting ‘till I finally gave up.</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">This book, and every poem, is an attempt <text:span text:style-name="T29">a</text:span>t <text:span text:style-name="T29">some</text:span> <text:span text:style-name="T29">nebulous feeling within me</text:span>. Whether you call it poetry or not, that’s why the cover says this is a collection of “Maybe-Poems.”</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">I hope you enjoy it! I hope it’s not too weird! I hope…</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">I hope you thought it was funny.</text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P46">Sincerely,</text:p>
   <text:p text:style-name="P46">Dare I say lovingly,</text:p>
   <text:p text:style-name="P46">I dare,</text:p>
   <text:p text:style-name="P46">I do dare,</text:p>
   <text:p text:style-name="P47">Love,</text:p>
   <text:p text:style-name="P46">Vova</text:p>
   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc6587_3499536570"/>I Want You To Touch Me<text:bookmark-end text:name="__RefHeading___Toc6587_3499536570"/></text:h>
   <text:p text:style-name="P49"/>
   <text:p text:style-name="Poetry_20_Text">I promise</text:p>
   <text:p text:style-name="Poetry_20_Text">I&apos;m quoting that phrase</text:p>
   <text:p text:style-name="Poetry_20_Text"><text:span text:style-name="T30">from</text:span> the end of a poem;</text:p>
   <text:p text:style-name="Poetry_20_Text"><text:span text:style-name="T31">An</text:span><text:span text:style-name="T30"> ending </text:span>I <text:span text:style-name="T30">liked,</text:span></text:p>
   <text:p text:style-name="P47"><text:span text:style-name="T31">that</text:span> I remember<text:span text:style-name="T31">ed</text:span> wrong.</text:p>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">Enough of <text:span text:style-name="T31">the</text:span> eye tag,</text:p>
   <text:p text:style-name="Poetry_20_Text">enough of the games,</text:p>
   <text:p text:style-name="Poetry_20_Text">enough of the nights spent</text:p>
   <text:p text:style-name="Poetry_20_Text">trying to figure out</text:p>
   <text:p text:style-name="Poetry_20_Text">our names.</text:p>
   <text:p text:style-name="Poetry_20_Text">Just</text:p>
   <text:p text:style-name="Poetry_20_Text">come out and</text:p>
   <text:p text:style-name="Poetry_20_Text">hollah at <text:span text:style-name="T30">yah</text:span> boy.</text:p>
   <text:p text:style-name="Poetry_20_Text">Anymore time spent</text:p>
   <text:p text:style-name="Poetry_20_Text">away from You,</text:p>
   <text:p text:style-name="Poetry_20_Text">when we&apos;re hanging out,</text:p>
   <text:p text:style-name="Poetry_20_Text">simply splits me inside.</text:p>
   <text:p text:style-name="Poetry_20_Text">I can&apos;t take it.</text:p>
   <text:p text:style-name="Poetry_20_Text">I want</text:p>
   <text:p text:style-name="Poetry_20_Text">I</text:p>
   <text:p text:style-name="Poetry_20_Text">I <text:s text:c="2"/>want</text:p>
   <text:p text:style-name="Poetry_20_Text"><text:s text:c="11"/>you <text:s text:c="2"/>to</text:p>
   <text:p text:style-name="Poetry_20_Text"><text:s text:c="22"/>touch</text:p>
   <text:p text:style-name="Poetry_20_Text"><text:s text:c="30"/>me.</text:p>
   <text:p text:style-name="Poetry_20_Text">Put your hand out</text:p>
   <text:p text:style-name="Poetry_20_Text">with mine,</text:p>
   <text:p text:style-name="Poetry_20_Text">and interlink our fingers—</text:p>
   <text:p text:style-name="Poetry_20_Text">feel my skin on yours,</text:p>
   <text:p text:style-name="Poetry_20_Text"><text:soft-page-break/>realize the warmth I give</text:p>
   <text:p text:style-name="Poetry_20_Text">when we&apos;re</text:p>
   <text:p text:style-name="Poetry_20_Text">actually</text:p>
   <text:p text:style-name="Poetry_20_Text"><draw:frame draw:style-name="fr1" draw:name="Image5" text:anchor-type="char" svg:x="0.0339in" svg:y="0.6634in" svg:width="4.2398in" svg:height="5.3575in" draw:z-index="7"><draw:image xlink:href="images/hands-touching.webp" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame>here.</text:p>
   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc5648_1813330706"/>But Not Until I&apos;ve Tasted You<text:bookmark-end text:name="__RefHeading___Toc5648_1813330706"/></text:h>
   <text:p text:style-name="P50"/>
   <text:p text:style-name="P50">Ollie I want to lick you—</text:p>
   <text:p text:style-name="P50">please man<text:span text:style-name="T32">,</text:span> come on,</text:p>
   <text:p text:style-name="P50">just one lick,</text:p>
   <text:p text:style-name="P50">just one</text:p>
   <text:p text:style-name="P50">to last a <text:span text:style-name="T33">lifetime</text:span><text:span text:style-name="T18"> bro,</text:span></text:p>
   <text:p text:style-name="P51">and then I promise,</text:p>
   <text:p text:style-name="P50"><text:span text:style-name="T18">I really </text:span><text:span text:style-name="T33">promise</text:span><text:span text:style-name="T18">,</text:span></text:p>
   <text:p text:style-name="P51">I won&apos;t ask again,</text:p>
   <text:p text:style-name="P51">really man,</text:p>
   <text:p text:style-name="P51">I won&apos;t ask again,</text:p>
   <text:p text:style-name="P51">just give me this one thing,</text:p>
   <text:p text:style-name="P51">this one ask.</text:p>
   <text:p text:style-name="P50"><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P51">This part is not poetry Ollie,</text:p>
   <text:p text:style-name="P51">I just <text:span text:style-name="T32">really </text:span>want to taste that Oliver</text:p>
   <text:p text:style-name="P51">sweetness<text:span text:style-name="T32">,</text:span></text:p>
   <text:p text:style-name="P52">that essence</text:p>
   <text:p text:style-name="P51">on this dry tongue<text:span text:style-name="T32">:</text:span></text:p>
   <text:p text:style-name="P51">lick you like a cat</text:p>
   <text:p text:style-name="P51">with barbed <text:span text:style-name="T32">flesh</text:span></text:p>
   <text:p text:style-name="P51">and</text:p>
   <text:p text:style-name="P51">draw out every ounce<draw:frame draw:style-name="fr2" draw:name="Image6" text:anchor-type="char" svg:x="2.3854in" svg:y="0.0319in" svg:width="2.4134in" svg:height="2.4228in" draw:z-index="8"><draw:image xlink:href="images/ollie-eating.webp" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="P51">so I don&apos;t forget.</text:p>
   <text:p text:style-name="P50"><text:span text:style-name="T18"/></text:p>
   <text:p text:style-name="P51">If I could just get your taste<text:span text:style-name="T32"> down</text:span>,</text:p>
   <text:p text:style-name="P51">the memory would be enough<text:span text:style-name="T32">.</text:span></text:p>
   <text:p text:style-name="P51">I&apos;d never need</text:p>
   <text:p text:style-name="P51">your flavor</text:p>
   <text:p text:style-name="P51">again.</text:p>
   <text:h text:style-name="P53" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc8144_1175081228"/>My Happiest Moment. Ever.<text:bookmark-end text:name="__RefHeading___Toc8144_1175081228"/></text:h>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text"><draw:frame draw:style-name="fr3" draw:name="Image3" text:anchor-type="char" svg:width="4.2791in" svg:height="0.9091in" draw:z-index="4"><draw:image xlink:href="images/its-a-promise.jpg" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/jpeg"/>
    </draw:frame></text:p>
   <text:p text:style-name="P54"/>
   <text:p text:style-name="P47">Have you ever felt it in your bones,</text:p>
   <text:p text:style-name="P47">down even to the pip of your very being</text:p>
   <text:p text:style-name="P47"><text:span text:style-name="T34">t</text:span>hat</text:p>
   <text:p text:style-name="P47">the pulp which makes you up,</text:p>
   <text:p text:style-name="P47">this human mass of <text:span text:style-name="T34">mystery</text:span> flesh,</text:p>
   <text:p text:style-name="P47"><text:s text:c="2"/>and blood,</text:p>
   <text:p text:style-name="P47"><text:s text:c="5"/>and gummy bits,</text:p>
   <text:p text:style-name="P47">could amount to something greater</text:p>
   <text:p text:style-name="P55">if only in the presence</text:p>
   <text:p text:style-name="P55">of another?</text:p>
   <text:p text:style-name="P47"/>
   <text:p text:style-name="P47">Have you ever made a promise</text:p>
   <text:p text:style-name="P47">and delayed it down the road</text:p>
   <text:p text:style-name="P47">just so you knew</text:p>
   <text:p text:style-name="P47">something good</text:p>
   <text:p text:style-name="P47">was coming?</text:p>
   <text:p text:style-name="P47"/>
   <text:p text:style-name="P47">Nothing in this life</text:p>
   <text:p text:style-name="P47">would make me happier</text:p>
   <text:p text:style-name="P47">than if You</text:p>
   <text:p text:style-name="P47">were someone who</text:p>
   <text:p text:style-name="P47">kept their word<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body>
      <text:p text:style-name="P56">I’ll be waiting ;)</text:p></text:note-body></text:note>.</text:p>
   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc8140_1175081228"/>Your Hips, Your Lips, Your Teeth<text:bookmark-end text:name="__RefHeading___Toc8140_1175081228"/></text:h>
   <text:p text:style-name="P57"/>
   <text:p text:style-name="Poetry_20_Text">My brother—</text:p>
   <text:p text:style-name="Poetry_20_Text">My lover—</text:p>
   <text:p text:style-name="Poetry_20_Text">My cover—</text:p>
   <text:p text:style-name="P58"/>
   <text:p text:style-name="Poetry_20_Text">You got them</text:p>
   <text:p text:style-name="Poetry_20_Text">Polish birthing hips</text:p>
   <text:p text:style-name="Poetry_20_Text">that wars were</text:p>
   <text:p text:style-name="Poetry_20_Text">fought over</text:p>
   <text:p text:style-name="Poetry_20_Text">in me<text:span text:style-name="T9">.</text:span></text:p>
   <text:p text:style-name="Poetry_20_Text">You got them</text:p>
   <text:p text:style-name="Poetry_20_Text">lips that curve</text:p>
   <text:p text:style-name="Poetry_20_Text">so sweetly,</text:p>
   <text:p text:style-name="Poetry_20_Text">one&apos;s I&apos;ll trace</text:p>
   <text:p text:style-name="Poetry_20_Text">like you&apos;re</text:p>
   <text:p text:style-name="Poetry_20_Text">in me<text:span text:style-name="T9">.</text:span></text:p>
   <text:p text:style-name="Poetry_20_Text">You got them</text:p>
   <text:p text:style-name="Poetry_20_Text">teeth that shine</text:p>
   <text:p text:style-name="Poetry_20_Text">right out and</text:p>
   <text:p text:style-name="Poetry_20_Text">eat just like mine</text:p>
   <text:p text:style-name="Poetry_20_Text">in me<text:span text:style-name="T9">.</text:span></text:p>
   <text:p text:style-name="Poetry_20_Text">But promise:</text:p>
   <text:p text:style-name="Poetry_20_Text">You got them</text:p>
   <text:p text:style-name="Poetry_20_Text">not to be</text:p>
   <text:p text:style-name="Poetry_20_Text">in me</text:p>
   <text:p text:style-name="Poetry_20_Text">but to be</text:p>
   <text:p text:style-name="Poetry_20_Text">with me<text:span text:style-name="T9">.</text:span></text:p>
   <text:p text:style-name="Poetry_20_Text">Promise</text:p>
   <text:p text:style-name="Poetry_20_Text">that this love</text:p>
   <text:p text:style-name="Poetry_20_Text">wasn&apos;t just physical, but always</text:p>
   <text:p text:style-name="Poetry_20_Text">in me.</text:p>
   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2555_4237564503"/>If Ollie Was A Girl<text:bookmark-end text:name="__RefHeading___Toc2555_4237564503"/></text:h>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">It wouldn’t change a damn thing.</text:p>
   <text:p text:style-name="Poetry_20_Text">My love</text:p>
   <text:p text:style-name="Poetry_20_Text">is not one of those</text:p>
   <text:p text:style-name="Poetry_20_Text">passions of the soul</text:p>
   <text:p text:style-name="Poetry_20_Text">that burn both ends.</text:p>
   <text:p text:style-name="Poetry_20_Text">It comes</text:p>
   <text:p text:style-name="Poetry_20_Text">and it goes,</text:p>
   <text:p text:style-name="Poetry_20_Text">just as a breeze;</text:p>
   <text:p text:style-name="Poetry_20_Text">One moment it’s there,</text:p>
   <text:p text:style-name="Poetry_20_Text">and the next,</text:p>
   <text:p text:style-name="Poetry_20_Text">you’re left in heat</text:p>
   <text:p text:style-name="Poetry_20_Text">with but a memory.<draw:frame draw:style-name="fr4" draw:name="Image7" text:anchor-type="char" svg:x="1.7535in" svg:y="0.1398in" svg:width="2.0209in" svg:height="3.8634in" draw:z-index="0"><draw:image xlink:href="images/dress-bod.webp" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame></text:p>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">I need</text:p>
   <text:p text:style-name="Poetry_20_Text">you,</text:p>
   <text:p text:style-name="Poetry_20_Text">not</text:p>
   <text:p text:style-name="P59">your face<text:span text:style-name="T35">—</text:span></text:p>
   <text:p text:style-name="P59">your voice<text:span text:style-name="T35">—</text:span></text:p>
   <text:p text:style-name="Poetry_20_Text">your touch.</text:p>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">You leave me</text:p>
   <text:p text:style-name="Poetry_20_Text">just as I</text:p>
   <text:p text:style-name="Poetry_20_Text">have left you.</text:p>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">Fair.</text:p>
   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1123_1230340041"/>Ollie <text:span text:style-name="T36">If</text:span> <text:span text:style-name="T36">H</text:span>e <text:span text:style-name="T36">W</text:span>as <text:span text:style-name="T36">A Chinese Eunuch</text:span><text:bookmark-end text:name="__RefHeading___Toc1123_1230340041"/></text:h>
   <text:p text:style-name="Poetry_20_Text"/>
   <text:p text:style-name="Poetry_20_Text">I woke up last night,</text:p>
   <text:p text:style-name="Poetry_20_Text">no dihh—</text:p>
   <text:p text:style-name="Poetry_20_Text">Oh, uhhh</text:p>
   <text:p text:style-name="Poetry_20_Text"><draw:frame draw:style-name="fr5" draw:name="Image14" text:anchor-type="char" svg:x="0.8035in" svg:y="2.6953in" svg:width="1.8366in" svg:height="0.9846in" draw:z-index="12"><draw:image xlink:href="images/chinese-john.webp" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
