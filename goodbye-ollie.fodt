   <text:p text:style-name="P87">I misunderstand</text:p>
   <text:p text:style-name="P87">like I have only known love.</text:p>
   <text:p text:style-name="P87"/>
   <text:p text:style-name="P87">I&apos;m sorry, <text:span text:style-name="T33">your honor,</text:span></text:p>
   <text:p text:style-name="P87">it&apos;s my fault I&apos;m me,</text:p>
   <text:p text:style-name="P87">and I am guilty</text:p>
   <text:p text:style-name="P87">of thinking others wrong</text:p>
   <text:p text:style-name="P87">for their choices.</text:p>
