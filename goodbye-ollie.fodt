   <text:p text:style-name="P62"><text:s text:c="2"/>reaching for my phone</text:p>
   <text:p text:style-name="P62"><text:s text:c="5"/>at every text</text:p>
   <text:p text:style-name="P62"><text:s text:c="6"/>hoping for</text:p>
   <text:p text:style-name="P62"><text:s text:c="7"/>a new message.</text:p>
   <text:p text:style-name="P62"><text:s text:c="2"/>the one prolonging</text:p>
   <text:p text:style-name="P62"><text:s text:c="8"/>the inevitable</text:p>
   <text:p text:style-name="P62"><text:s text:c="10"/>here, beating a</text:p>
