   <text:p text:style-name="P184">I’m <text:span text:style-name="T95">not</text:span> a <text:span text:style-name="T33">good</text:span> liar</text:p>
   <text:p text:style-name="P184">I’m a <text:span text:style-name="T33">great</text:span> liar,</text:p>
