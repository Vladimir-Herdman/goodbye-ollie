   <text:p text:style-name="P62">hand on book</text:p>
   <text:p text:style-name="P62">I swear</text:p>
   <text:p text:style-name="P62">I&apos;m not</text:p>
   <text:p text:style-name="P62"><text:s text:c="2"/>up at night thinking</text:p>
   <text:p text:style-name="P62"><text:s text:c="5"/>dreaming</text:p>
   <text:p text:style-name="P62"><text:s text:c="7"/>wanting</text:p>
