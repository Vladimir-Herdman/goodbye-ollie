   <text:p text:style-name="Poetry_20_Text">played upon itself,</text:p>
   <text:p text:style-name="Poetry_20_Text">and this mess</text:p>
   <text:p text:style-name="Poetry_20_Text">is covered in you,</text:p>
   <text:p text:style-name="Poetry_20_Text">or you</text:p>
