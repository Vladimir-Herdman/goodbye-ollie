   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2547_4237564503"/>I Confess I Confess<text:bookmark-end text:name="__RefHeading___Toc2547_4237564503"/></text:h>
   <text:p text:style-name="P180"/>
   <text:p text:style-name="P180">I confess I <text:span text:style-name="T94">fucking </text:span>hated <text:span text:style-name="T35">y</text:span>ou.</text:p>
   <text:p text:style-name="P180">I confess I wanted to break up.</text:p>
   <text:p text:style-name="P181">I confess I was scared to be with you.</text:p>
