   <text:p text:style-name="P185">and I don’t regret anything,</text:p>
   <text:p text:style-name="P185">and I love my poems,</text:p>
   <text:p text:style-name="P186"><text:span text:style-name="T96">a</text:span>nd<text:span text:style-name="T96"> </text:span>I don&apos;t miss You<text:span text:style-name="T96">,</text:span></text:p>
   <text:p text:style-name="P184">and</text:p>
   <text:p text:style-name="P187">and I’m—</text:p>
   <text:p text:style-name="P184">I’m happy<text:span text:style-name="T51">.</text:span></text:p>
