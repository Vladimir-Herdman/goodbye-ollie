   <text:p text:style-name="P3"><text:span text:style-name="T1">­</text:span>GOODBYE OLLIE<text:span text:style-name="T1">­</text:span></text:p>
   <text:p text:style-name="P4"/>
   <text:p text:style-name="P4"/>
   <text:p text:style-name="P5"/>
