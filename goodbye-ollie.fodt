   <text:p text:style-name="P87">of hating</text:p>
   <text:p text:style-name="P87">like all those</text:p>
   <text:p text:style-name="P87">before me.</text:p>
   <text:p text:style-name="P87"/>
   <text:p text:style-name="P87">I am guilty</text:p>
   <text:p text:style-name="P87">of never stopping other&apos;s hate</text:p>
   <text:p text:style-name="P87">for</text:p>
