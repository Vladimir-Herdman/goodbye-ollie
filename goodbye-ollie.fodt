   <text:p text:style-name="P79">so they drank their partner entire<text:span text:style-name="T45">.</text:span></text:p>
   <text:p text:style-name="P80"/>
   <text:p text:style-name="P79"><text:span text:style-name="T47">And i</text:span>n all these lands,</text:p>
