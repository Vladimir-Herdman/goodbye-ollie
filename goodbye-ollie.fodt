   <text:h text:style-name="P48" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc4881_1189619379"/>Just Two Cowboys Riding<text:bookmark-end text:name="__RefHeading___Toc4881_1189619379"/></text:h>
   <text:p text:style-name="P75"/>
   <text:p text:style-name="P77">Look out yonder West<text:span text:style-name="T45">,</text:span> young buck.</text:p>
