   <text:p text:style-name="P178">grinning between sobs<text:span text:style-name="T35">—</text:span></text:p>
   <text:p text:style-name="P178">who say</text:p>
   <text:p text:style-name="P178">you&apos;ve been dirtied.</text:p>
   <text:p text:style-name="P178"/>
